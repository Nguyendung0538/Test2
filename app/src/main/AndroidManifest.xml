<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".PayrollApplication"
        android:allowBackup="false"
        android:label="Payroll Management"
        android:supportsRtl="true"
        android:theme="@style/Theme.Payroll">
        <activity android:name=".ui.admin.AdminMainActivity" android:exported="false" />
        <activity android:name=".ui.employee.EmployeeMainActivity" android:exported="false" />
        <activity android:name=".ui.auth.LoginActivity" android:exported="false" />
        <activity android:name=".ui.auth.SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Employee Activities -->
        <activity
            android:name=".EmployeeDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".AttendanceHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".SalaryDetailActivity"
            android:exported="false" />
    </application>
</manifest>